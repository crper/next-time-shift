{
  "name": "next-time-shift",
  "description": "Time Shift is a tool that helps you convert timestamps between different timezones.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm test && pnpm type-check && pnpm build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crper/next-time-shift.git"
  },
  "author": "crper",
  "license": "MIT",
  "homepage": "https://github.com/crper/next-time-shift",
  "keywords": [
    "time-shift",
    "timezone",
    "timestamp",
    "timezone-converter",
    "timezone-converter-react",
    "timezone-converter-nextjs",
    "timezone-converter-antd",
    "timezone-converter-luxon",
    "timezone-converter-vvo-tzdb"
  ],
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@tanstack/react-virtual": "^3.13.21",
    "@vvo/tzdb": "^6.198.0",
    "antd": "^5.29.3",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "dayjs": "^1.11.19",
    "es-toolkit": "^1.45.1",
    "husky": "^9.1.7",
    "luxon": "^3.7.2",
    "motion": "^12.35.2",
    "next": "15.5.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.12",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
